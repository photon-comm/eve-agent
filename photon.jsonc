{
  "$schema": "https://photon.codes/schema/template/v1.json",
  "specVersion": 1,
  "compatibilityDate": "2026-10-13",

  "name": "eve-agent",
  "version": "1.0.0",
  "title": "Vercel Eve Agent",
  "description": "An assistant you text over iMessage, built on eve, Vercel's agent framework.",
  "categories": ["assistant"],
  "author": { "name": "Photon", "url": "https://photon.codes" },
  "license": "MIT",
  "links": { "docs": "./README.md" },

  "channels": [{ "type": "imessage", "lines": ["shared", "dedicated"], "defaultLine": "shared" }],

  // eve's Photon channel takes webhooks and verifies the Spectrum signature.
  "delivery": {
    "type": "webhook",
    "path": "/eve/v1/photon",
    "signature": "spectrum-v0",
  },

  // The names eve's channel already reads. Photon writes these four and nothing else.
  "bindings": {
    "IMESSAGE_PROJECT_ID": "photon.project.id",
    "IMESSAGE_PROJECT_SECRET": "photon.project.secret",
    "IMESSAGE_WEBHOOK_SECRET": "photon.webhook.secret",
    "IMESSAGE_ALLOWED_USERS": "photon.owner.phones",
  },

  // The model runs through Vercel AI Gateway on the person's own Vercel account,
  // so there is nothing for them to fill in.

  "hosts": {
    "vercel": { "environments": ["production"] },
    "source": { "guide": "./README.md#deploy-by-hand", "envFile": ".env" },
  },
  "defaultHost": "vercel",
}
