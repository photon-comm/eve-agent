{
  "$schema": "https://photon.codes/schema/template/v1.json",
  "specVersion": 1,
  "compatibilityDate": "2026-10-13",

  "name": "eve-agent",
  "version": "2.0.0",
  "title": "Vercel Eve Agent",
  "description": "An assistant people message on iMessage, WhatsApp, Telegram, SMS and email, built on eve, Vercel's agent framework.",
  "categories": ["assistant"],
  "author": { "name": "Photon", "url": "https://photon.codes" },
  "license": "MIT",
  "links": { "docs": "./README.md" },

  "channels": [
    { "type": "imessage", "lines": ["shared", "dedicated"], "defaultLine": "shared" },
    { "type": "whatsapp_personal", "lines": ["shared", "dedicated"], "defaultLine": "shared" },
    { "type": "whatsapp_business" },
    { "type": "telegram" },
    { "type": "sms" },
    { "type": "email" },
  ],

  // Photon's Chat SDK adapter takes webhooks and verifies the Standard Webhooks signature.
  "delivery": {
    "type": "webhook",
    "path": "/eve/v1/photon",
    "signature": "standard-webhooks",
  },

  // The names the adapter and the allowlist in agent/channels/photon.ts read.
  // Photon writes these five and nothing else.
  "bindings": {
    "PHOTON_PROJECT_ID": "photon.project.id",
    "PHOTON_API_KEY": "photon.project.secret",
    "PHOTON_API_URL": "photon.api.url",
    "PHOTON_WEBHOOK_SECRET": "photon.webhook.secret",
    "PHOTON_ALLOWED_USERS": "photon.owner.phones",
  },

  // The model runs through Vercel AI Gateway on the person's own Vercel account,
  // so there is nothing for them to fill in.

  "hosts": {
    "vercel": { "environments": ["production"] },
    "source": { "guide": "./README.md#deploy-by-hand", "envFile": ".env" },
  },
  "defaultHost": "vercel",
}
