# Copy this file to .env.local for local runs. On Vercel, set these in the
# project's Environment Variables instead. Never commit real values.

# Required. Your Photon project ID. Find it in the Photon Beta dashboard
# (https://app.beta.photon.codes) on your project's API keys page.
PHOTON_PROJECT_ID=

# Required. A project API key with project:read and project:write and no
# expiry, created on the same API keys page. It lets the agent send replies.
# Keep it private.
PHOTON_API_KEY=

# Required to receive messages. The signing secret of the Photon webhook
# destination that points to https://<your-host>/eve/v1/photon, with API
# version 2026-07-01 and the message.received event. Add the destination on
# your project's Webhooks page in the Photon Beta dashboard. The secret is
# shown once.
PHOTON_WEBHOOK_SECRET=

# Optional. The Photon API the agent calls. Leave it unset to use
# https://api.photon.codes. Remove the # to use it.
# PHOTON_API_URL=

# Optional. Who the agent answers: a comma-separated list of senders' handles,
# such as phone numbers in E.164 format (like +15551234567) and email
# addresses. Messages from anyone else are ignored. Leave it empty to answer
# everyone.
PHOTON_ALLOWED_USERS=

# Optional. Not needed on Vercel, where the deployment signs in to AI Gateway
# with its OIDC token. Set it to run the agent on another host, or locally if
# you skip `eve dev`'s own sign-in. Create a key in the Vercel dashboard under
# AI Gateway, API Keys. Remove the # to use it.
# AI_GATEWAY_API_KEY=
