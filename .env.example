# Copy this file to .env.local for local runs. On Vercel, set these in the
# project's Environment Variables instead. Never commit real values.

# Required. Your Photon project ID. Find it in the Photon dashboard
# (https://app.photon.codes) on your project's API keys page.
IMESSAGE_PROJECT_ID=

# Required. Your Photon project secret, from the same API keys page.
# It lets the agent send replies. Keep it private.
IMESSAGE_PROJECT_SECRET=

# Required to receive messages. The signing secret of the Photon webhook that
# points to https://<your-host>/eve/v1/photon. Create the webhook on your
# project's Webhooks page in the Photon dashboard. The secret is shown once.
IMESSAGE_WEBHOOK_SECRET=

# Optional. Who the agent answers: a comma-separated list of phone numbers in
# E.164 format (like +15551234567) or Apple ID emails. Messages from anyone
# else are ignored. Leave it empty to answer everyone.
IMESSAGE_ALLOWED_USERS=

# Optional. Not needed on Vercel, where the deployment signs in to AI Gateway
# with its OIDC token. Set it to run the agent on another host, or locally if
# you skip `eve dev`'s own sign-in. Create a key in the Vercel dashboard under
# AI Gateway, API Keys. Remove the # to use it.
# AI_GATEWAY_API_KEY=
